{
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "jest --watchAll",
    "lint": "eslint .",
    "build-ios": "eas build -p ios --profile production --auto-submit --no-wait",
    "build-and-install": "eas build --platform ios --profile development --local && eas build:run -p ios --path=$(ls -t /Users/alex/aarich/react-native-intervals/*.tar.gz | head -n 1)",
    "build-android": "eas build -p android --profile production --auto-submit --no-wait",
    "build-web": "node scripts/preBuildWeb.js && npx expo export -p web && node scripts/postBuildWeb.js",
    "deploy-web": "bash scripts/deploy-web.sh",
    "build-and-submit": "eas build --platform ios --profile production --local && eas submit --platform ios --path=$(ls -t /Users/alex/aarich/react-native-intervals/*.ipa | head -n 1)",
    "postbuild-and-submit": "rm *.ipa",
    "update": "eas update --channel production --message \"update via npm script\" --environment production",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "homepage": "/intervals",
  "jest": {
    "preset": "jest-expo"
  },
